[ext_resource type="Script" path="res://scripts/camera/ChaseCamera.cs" id="2_cam"]
[ext_resource type="Script" path="res://scripts/ui/DebugHud.cs" id="3_hud"]

[sub_resource type="ProceduralSkyMaterial" id="Sky_mat"]
sky_top_color = Color(0.28, 0.47, 0.78, 1)
sky_horizon_color = Color(0.68, 0.76, 0.86, 1)
ground_horizon_color = Color(0.6, 0.66, 0.62, 1)

[sub_resource type="Sky" id="Sky_res"]
sky_material = SubResource("Sky_mat")

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky_res")
ambient_light_source = 3
tonemap_mode = 3
ssao_enabled = true
fog_enabled = true
fog_light_color = Color(0.68, 0.76, 0.86, 1)
fog_density = 0.0015

[sub_resource type="Shader" id="Ground_shader"]
code = "shader_type spatial;
// 10 m reference grid so speed and heading are readable before the track is built.
uniform vec4 base_color : source_color = vec4(0.22, 0.34, 0.21, 1.0);
uniform vec4 line_color : source_color = vec4(0.82, 0.82, 0.78, 1.0);
varying vec3 world_pos;
void vertex() { world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
	vec2 c = world_pos.xz / 10.0;
	vec2 g = abs(fract(c - 0.5) - 0.5) / fwidth(c);
	float line = 1.0 - min(min(g.x, g.y), 1.0);
	ALBEDO = mix(base_color.rgb, line_color.rgb, line * 0.7);
	ROUGHNESS = 0.95;
}
"

[sub_resource type="ShaderMaterial" id="Ground_mat"]
shader = SubResource("Ground_shader")

[sub_resource type="PlaneMesh" id="Ground_mesh"]
material = SubResource("Ground_mat")
size = Vector2(4000, 4000)

[node name="Main" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
